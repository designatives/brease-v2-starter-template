{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Page content",
  "description": "Content JSON of every Brease page, per template (the `template` key). TypeScript mirror: src/lib/content.ts.",
  "oneOf": [{ "$ref": "#/$defs/home" }, { "$ref": "#/$defs/page" }, { "$ref": "#/$defs/global" }],
  "$defs": {
    "link": {
      "type": "object",
      "required": ["label", "href"],
      "properties": { "label": { "type": "string" }, "href": { "type": "string" } }
    },
    "html": {
      "type": "string",
      "description": "HTML: <p>, <h2>, <h3>, <ul>/<ol>, <blockquote>; <strong>, <em> and <a href> inline"
    },
    "home": {
      "type": "object",
      "required": ["template", "hero", "features", "closing"],
      "properties": {
        "template": { "const": "home" },
        "hero": {
          "type": "object",
          "required": ["eyebrow", "title", "text", "cta"],
          "properties": {
            "eyebrow": { "type": "string" },
            "title": { "type": "string" },
            "text": { "type": "string" },
            "cta": { "$ref": "#/$defs/link" }
          }
        },
        "features": {
          "type": "object",
          "required": ["title", "items"],
          "properties": {
            "title": { "type": "string" },
            "items": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["title", "text"],
                "properties": { "title": { "type": "string" }, "text": { "type": "string" } }
              }
            }
          }
        },
        "closing": {
          "type": "object",
          "required": ["title", "text", "cta"],
          "properties": {
            "title": { "type": "string" },
            "text": { "type": "string" },
            "cta": { "$ref": "#/$defs/link" }
          }
        }
      }
    },
    "page": {
      "type": "object",
      "required": ["template", "title", "intro", "body"],
      "properties": {
        "template": { "const": "page" },
        "title": { "type": "string" },
        "intro": { "type": "string" },
        "body": { "$ref": "#/$defs/html" }
      }
    },
    "global": {
      "type": "object",
      "required": ["template", "siteName", "footer"],
      "properties": {
        "template": { "const": "global" },
        "siteName": { "type": "string" },
        "footer": {
          "type": "object",
          "required": ["text", "copyright"],
          "properties": { "text": { "type": "string" }, "copyright": { "type": "string" } }
        }
      }
    }
  }
}
