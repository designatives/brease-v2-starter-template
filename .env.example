# Brease delivery API (Brease writes BREASE_TOKEN and BREASE_REVALIDATE_SECRET into the Vercel project)
BREASE_TOKEN=
# Optional; defaults to https://api.brease.io. Local Brease: http://localhost:3000
BREASE_API_URL=
# Secret of the revalidate route (app/api/brease/revalidate) that Brease calls after content releases
BREASE_REVALIDATE_SECRET=

# Brease on-site toolbar (comments). The loader tag is rendered only when all three are set.
NEXT_PUBLIC_BREASE_OVERLAY_URL=
NEXT_PUBLIC_BREASE_SITE_ID=
NEXT_PUBLIC_BREASE_APP_ORIGIN=

# Public URL of the site (canonical URLs, sitemap)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
